<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 11+ package visibility: without this, resolveActivity() returns
      null even when Medha is installed, and the sample would report "not
      installed" on any modern device. This is the single most common thing
      that breaks a working integration on upgrade.
    -->
    <queries>
        <package android:name="com.adabala.medha" />
    </queries>

    <!--
      Medha binds to 127.0.0.1, so no INTERNET permission is needed for
      loopback traffic on Android. usesCleartextTraffic is required because
      the local server is plain HTTP.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HelloMedha"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
