*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
/app/build/
/captures/
.externalNativeBuild/
.cxx/

# The Gradle wrapper is intentionally committed: it pins the build tool version
# so CI and every developer use the same Gradle. Do not let a broad *.jar rule
# swallow it.
!gradle/wrapper/gradle-wrapper.jar

# tools/tests/webapp_smoke_test.js's jsdom dependency. Not part of the Android
# build; installed on demand via `npm install` in tools/tests/.
tools/tests/node_modules/
tools/tests/package-lock.json

# The sample is a separate Gradle project, so the root-anchored /build/ and
# /app/build/ rules above do not reach its output. Without these, a local
# build of the sample would offer its entire intermediates tree for commit.
samples/*/build/
samples/*/app/build/
samples/*/dist/
