<resources>
    <color name="indigo">#5B3FA8</color>
    <color name="indigo_dark">#3B2E7E</color>
    <color name="on_indigo">#FFFFFF</color>
    <color name="indigo_container">#E7E0FA</color>
    <color name="on_indigo_container">#241261</color>
    <color name="saffron">#F48C2E</color>
    <color name="on_saffron">#3A1D00</color>
    <color name="ok_green">#1B8A3A</color>
    <color name="warn_amber">#D68910</color>
    <color name="err_red">#C0392B</color>
    <color name="neutral_grey">#7F8C8D</color>
    <color name="surface_soft">#F3F0FF</color>

    <!--
      Added for dark-theme support: these were previously hardcoded hex
      literals directly in activity_main.xml (cardBackgroundColor="#FFFFFF",
      textColor="#333333"/"#555555"), which meant the four non-brand cards
      stayed stark white with dark text no matter what system theme setting
      was active. values-night/colors.xml overrides these three; every other
      color in this file is a fixed brand/status color that's intentionally
      the same in both themes (the indigo status card, toolbar, and nav
      header all use a permanently dark brand background by design, same as
      the widget).
    -->
    <color name="card_surface">#FFFFFF</color>
    <color name="text_primary">#333333</color>
    <color name="text_secondary">#555555</color>

    <!--
      Brief surfaces.

      The widget used to be a fixed indigo gradient with hex literals in the
      layout, which read as a coloured block sitting on the wallpaper while
      every system widget around it was a soft translucent card. These follow
      the system theme via values-night, the way Samsung's own Now Brief card
      does, so Medha's widget belongs on the same home screen rather than
      competing with it.

      Alpha is deliberate: the widget background is translucent so the
      wallpaper shows through, which is most of what makes a card read as
      part of the launcher rather than pasted on top.
    -->
    <color name="brief_widget_bg">#E8FFFFFF</color>
    <color name="brief_widget_title">#1A1033</color>
    <color name="brief_widget_body">#4A4060</color>
    <color name="brief_widget_meta">#7A6FA8</color>
    <color name="brief_widget_brand">#5B3FA8</color>
    <color name="brief_accent">#5B3FA8</color>

    <color name="brief_screen_bg">#F7F4FF</color>
    <color name="brief_card_bg">#FFFFFF</color>
    <color name="brief_headline">#1A1033</color>
</resources>
