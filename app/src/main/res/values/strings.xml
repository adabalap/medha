    <string name="sched_title">Thermal &amp; scheduling</string>
    <string name="sched_hint">Android exposes no temperature reading to apps. These are
        thermal HEADROOM values: 0.0 is cool, 1.0 means the chip is throttling now.
        Background batch work pauses at the upper mark and resumes at the lower one.
        Interactive requests are never blocked.</string>
