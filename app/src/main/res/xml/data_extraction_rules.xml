<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="database" path="medha.db" />
        <exclude domain="sharedpref" path="com.adabala.medha_preferences.xml" />
        <exclude domain="sharedpref" path="com.adabala.medha.debug_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="com.adabala.medha_preferences.xml" />
        <exclude domain="sharedpref" path="com.adabala.medha.debug_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
