<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawer header.

  fitsSystemWindows on the NavigationView REPLACES this view's padding with the
  window insets rather than adding to it, which is why the title was being drawn
  under the status bar and clipped. MainActivity now applies the top inset
  programmatically via setOnApplyWindowInsetsListener, and this layout carries
  only its own visual padding. The id is required for that.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navHeaderRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/indigo_dark"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_medha_mark"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_header_title"
                android:textColor="@color/on_indigo"
                android:textSize="19sp"
                android:textStyle="bold"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/navHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/nav_header_subtitle"
                android:textColor="#D8CCF4"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/navHeaderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/state_stopped"
        android:textColor="@color/on_indigo"
        android:textSize="12sp" />
</LinearLayout>
