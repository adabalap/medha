<?xml version="1.0" encoding="utf-8"?>
<!--
  A band heading: OVERDUE, THIS WEEK, LATER, NO DATE.

  Groups by when a thing is due rather than by which app wrote it. The old
  screen grouped by app, which answered a question nobody asked while they
  were looking at an overdue bill; attribution moved onto the row, and only
  shows up when more than one app is writing.

  The rule the hairline fades out from is the same rule as everywhere else:
  the band colour is the signal, so it is a fixed colour and not a themed
  one. Everything structural on this screen takes the system's palette; the
  three urgency colours never do.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="22dp"
    android:paddingBottom="6dp">

    <TextView android:id="@+id/bandLabel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:letterSpacing="0.12"
        android:textStyle="bold"
        android:text="" />

    <TextView android:id="@+id/bandCount"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?android:attr/textColorSecondary"
        android:text="" />
</LinearLayout>
