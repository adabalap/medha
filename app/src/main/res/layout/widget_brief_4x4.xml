                android:maxLines="1" android:ellipsize="end" android:text="" />
            <TextView android:id="@+id/widgetText5"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12.5sp" android:textColor="@color/brief_widget_body"
                android:maxLines="1" android:ellipsize="end"
                android:lineSpacingExtra="1dp" android:text="" />
        </LinearLayout>

        <TextView android:id="@+id/widgetMark5"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="10dp" android:textSize="10.5sp"
            android:textStyle="bold" android:textColor="@color/brief_widget_meta"
            android:maxLines="1" android:ellipsize="end" android:text="" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widgetRow6"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:paddingTop="7dp">

        <ImageView android:id="@+id/widgetBar6"
            android:layout_width="3dp" android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:src="@drawable/bar_none" />

        <ImageView android:id="@+id/widgetIcon6"
            android:layout_width="15dp" android:layout_height="15dp"
            android:layout_marginEnd="9dp" android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_kind_note" />

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widgetTitle6"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold"
                android:textColor="@color/brief_widget_title"
                android:maxLines="1" android:ellipsize="end" android:text="" />
            <TextView android:id="@+id/widgetText6"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12.5sp" android:textColor="@color/brief_widget_body"
                android:maxLines="1" android:ellipsize="end"
                android:lineSpacingExtra="1dp" android:text="" />
        </LinearLayout>

        <TextView android:id="@+id/widgetMark6"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="10dp" android:textSize="10.5sp"
            android:textStyle="bold" android:textColor="@color/brief_widget_meta"
            android:maxLines="1" android:ellipsize="end" android:text="" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widgetRow7"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false" android:paddingTop="7dp">

        <ImageView android:id="@+id/widgetBar7"
            android:layout_width="3dp" android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
            android:scaleType="fitXY"
            android:contentDescription="@null"
            android:src="@drawable/bar_none" />

        <ImageView android:id="@+id/widgetIcon7"
            android:layout_width="15dp" android:layout_height="15dp"
            android:layout_marginEnd="9dp" android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_kind_note" />

        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widgetTitle7"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold"
                android:textColor="@color/brief_widget_title"
                android:maxLines="1" android:ellipsize="end" android:text="" />
            <TextView android:id="@+id/widgetText7"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12.5sp" android:textColor="@color/brief_widget_body"
                android:maxLines="1" android:ellipsize="end"
                android:lineSpacingExtra="1dp" android:text="" />
        </LinearLayout>

        <TextView android:id="@+id/widgetMark7"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingStart="10dp" android:textSize="10.5sp"
            android:textStyle="bold" android:textColor="@color/brief_widget_meta"
            android:maxLines="1" android:ellipsize="end" android:text="" />
    </LinearLayout>

    </LinearLayout>

    <TextView android:id="@+id/widgetFold" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="10dp"
        android:textSize="10.5sp" android:textColor="@color/brief_widget_meta"
        android:maxLines="1" android:ellipsize="end" android:text="" />

</LinearLayout>
