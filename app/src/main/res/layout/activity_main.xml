<?xml version="1.0" encoding="utf-8"?>
<!--
  Medha, rebuilt around three questions instead of sixteen menu items.

  WHAT THIS REPLACED

  A navigation drawer of sixteen entries, fourteen of which opened a dialog,
  over a single scroll that mixed a live status readout with every setting
  the app has. Nothing was hard to REACH and everything was hard to FIND,
  which is the particular kind of clutter that accumulates when features are
  added one drawer item at a time.

  THE SPLIT

    Home      is it running, and how does an app reach it
    Apps      what is connected
    Settings  the things set once and then forgotten

  Everything that was a drawer item is now either a control on the surface
  it belongs to or a row in a Settings group. The client list in particular
  stopped being a dialog: "what is connected to this" is a question about
  the app's state, and state does not belong behind a modal you dismiss by
  tapping beside it.

  WHY THE IDS DID NOT CHANGE

  Every view id from the previous layout survives here, deliberately. This
  file cannot be compiled by anything in tools/, so a rename would surface
  as a Gradle failure minutes later with no local signal at all. The
  rearrangement is real; the vocabulary MainActivity binds against is not
  touched, and tools/check_resources.py verifies both directions.

  Type comes from the Material 3 scale by theme attribute rather than from
  sp values, so it follows the device font and the dynamic palette.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent">
        <include android:id="@+id/toolbarTitle" layout="@layout/toolbar_title" />
    </com.google.android.material.appbar.MaterialToolbar>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false" android:scrollbars="none"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              Shown only after a crash, and only until it is dismissed.

              Every crash already writes a dump, but the one way to reach
              those dumps was Settings › Diagnostics. When the thing that
              crashes IS the Settings tab, the report is sealed inside the
              screen that cannot open: three rounds of "please send me the
              trace" with no way for anyone to send it. A crash notice
              belongs somewhere that does not depend on the app still
              working.
            -->
            <LinearLayout android:id="@+id/crashBanner"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_brief_card"
                android:padding="18dp" android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorError"
                    android:text="@string/crash_title" />

                <TextView android:id="@+id/crashDetail"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCrashShare"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/crash_share" app:icon="@drawable/ic_open_in_new" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCrashDismiss"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/crash_dismiss" />
                </LinearLayout>
            </LinearLayout>

            <!-- One question, answered at the top: is it running. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_brief_card"
                android:padding="20dp" android:layout_marginTop="12dp">

                <TextView android:id="@+id/statusText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:text="@string/status_idle" />

                <TextView android:id="@+id/statusDetail"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/loadProgress"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:indeterminate="true" android:visibility="gone"
                    app:trackCornerRadius="4dp" />

                <!--
                  Two buttons that stay the same size as each other.

                  layout_height="match_parent" inside a wrap_content row is
                  the equal-height idiom: the row takes the height of its
                  tallest child and both children then fill it. Without it,
                  Start was taller than Stop whenever its label ran to two
                  lines — and its label changes with state ("Start Medha",
                  "Loading model…", "Choose model file"), so the row went
                  uneven on its own, in some states and not others.

                  maxLines + ellipsize keeps a long label on one line rather
                  than growing the whole row to fit it.
                -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="18dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStart"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="match_parent" android:minHeight="52dp"
                        android:maxLines="1" android:ellipsize="end"
                        android:text="@string/btn_start" app:icon="@drawable/ic_play" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="match_parent" android:minHeight="52dp"
                        android:layout_marginStart="10dp"
                        android:maxLines="1" android:ellipsize="end"
                        android:text="@string/stop" app:icon="@drawable/ic_stop" />
                </LinearLayout>
            </LinearLayout>

            <!--
              Live numbers, each one labelled.

              The redesign dropped the labels and left three identical grey
              pills showing a bare number, or in statSpeed's case nothing at
              all, because only the streaming path ever wrote to it while the
              other two were given an em dash when idle. Three grey boxes, one
              of them blank, is not a readout.

              The strings were already here; nothing had used them since.
            -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp"
                android:baselineAligned="false">

                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="center" android:background="@drawable/bg_stat"
                    android:paddingTop="12dp" android:paddingBottom="12dp">
                    <TextView android:id="@+id/statSpeed"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:maxLines="1" android:text="@string/stat_placeholder" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="@string/stat_speed" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="center" android:layout_marginStart="10dp"
                    android:background="@drawable/bg_stat"
                    android:paddingTop="12dp" android:paddingBottom="12dp">
                    <TextView android:id="@+id/statQueue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:maxLines="1" android:text="@string/stat_placeholder" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="@string/stat_queue" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:gravity="center" android:layout_marginStart="10dp"
                    android:background="@drawable/bg_stat"
                    android:paddingTop="12dp" android:paddingBottom="12dp">
                    <TextView android:id="@+id/statThermal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:maxLines="1" android:text="@string/stat_placeholder" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingTop="2dp"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="@string/stat_thermal" />
                </LinearLayout>
            </LinearLayout>

            <!-- The second question: how does an app reach it. -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="22dp" android:paddingBottom="8dp" android:paddingStart="4dp"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorPrimary" android:text="@string/sec_connect" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_brief_card"
                android:padding="18dp">

                <TextView android:id="@+id/endpointText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="monospace" android:textIsSelectable="true"
                    android:textAppearance="?attr/textAppearanceBodyMedium" android:text="" />

                <TextView android:id="@+id/tokenText"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="10dp" android:fontFamily="monospace"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary" android:text="" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyToken"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/copy_token" app:icon="@drawable/ic_key" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sectionApps"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone"
        android:clipToPadding="false" android:scrollbars="none"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:id="@+id/appsEmpty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="26dp" android:paddingBottom="10dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/apps_empty" />

            <!-- The client list, inline. It was a dialog, which meant the
                 answer to "what is connected to this" was three taps into a
                 drawer and then dismissed by tapping anywhere. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsClientList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- Adding an API client. This was the neutral button on the
                 clients DIALOG, and when that dialog stopped being reachable
                 in v0.17.0 the whole flow went with it: there was no longer
                 any way to add a client at all. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddClient"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/add_client" app:icon="@drawable/ic_client" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPairWeb"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/pair_web" app:icon="@drawable/ic_pair" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenDemo"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/open_demo" app:icon="@drawable/ic_open_in_new" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sectionSettings"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone"
        android:clipToPadding="false" android:scrollbars="none"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="22dp" android:paddingBottom="8dp" android:paddingStart="4dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary"
            android:text="@string/sec_model" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_brief_card"
            android:padding="14dp">
            <TextView android:id="@+id/modelPathText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary" android:text="" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickModel"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pick_model" app:icon="@drawable/ic_book" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="20dp" android:paddingBottom="8dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:text="@string/backend" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/backendToggle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backendGpu"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="@string/backend_gpu" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backendCpu"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="@string/backend_cpu" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backendNpu"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="@string/backend_npu" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:hint="@string/port"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editPort"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:id="@+id/configLockedHint"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" android:text="@string/config_locked" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="22dp" android:paddingBottom="8dp" android:paddingStart="4dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary"
            android:text="@string/sec_perf" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_brief_card"
            android:padding="14dp">
            <TextView android:id="@+id/pauseLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelLarge" android:text="" />
            <!--
              These two carry THERMAL HEADROOM, a fraction roughly 0.2-1.2,
              not a 0-10 count. The range has to say so.

              A Slider whose value does not land on a step tick throws
              IllegalStateException - and it checks at DRAW time, not when
              the value is set. While this said 0..10 step 1, setupScheduler
              assigned 0.85 at startup without complaint, because a GONE
              view never draws; the app then died the instant the Settings
              tab was shown and Android dropped the user on the launcher.
              It read as "Settings minimises the app".

              (valueTo - valueFrom) must also be a whole number of steps:
              (1.20 - 0.30) / 0.05 = 18. tools/check_sliders.py enforces both.
            -->
            <com.google.android.material.slider.Slider
                android:id="@+id/pauseSlider"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:valueFrom="0.30" android:valueTo="1.20" android:stepSize="0.05" />

            <TextView android:id="@+id/resumeLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:textAppearance="?attr/textAppearanceLabelLarge" android:text="" />
            <com.google.android.material.slider.Slider
                android:id="@+id/resumeSlider"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:valueFrom="0.20" android:valueTo="1.10" android:stepSize="0.05" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCharging"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:minHeight="48dp"
                android:text="@string/batch_charging" />

            <TextView android:id="@+id/schedState"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary" android:text="" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="22dp" android:paddingBottom="8dp" android:paddingStart="4dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary"
            android:text="@string/sec_brief" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_brief_card"
            android:padding="14dp">
            <LinearLayout android:id="@+id/rowBrief"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="56dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="18dp" android:contentDescription="@null"
                    android:src="@drawable/ic_book" />
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:text="@string/nav_brief" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowBriefTheme"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="56dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="18dp" android:contentDescription="@null"
                    android:src="@drawable/ic_tune" />
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:text="@string/theme_title" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowNotifListen"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="56dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="18dp" android:contentDescription="@null"
                    android:src="@drawable/ic_info" />
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:text="@string/notif_listen_title" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowNudge"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="56dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="18dp" android:contentDescription="@null"
                    android:src="@drawable/ic_stat_medha" />
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:text="@string/nudge_setting" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowUndismiss"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="56dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="18dp" android:contentDescription="@null"
                    android:src="@drawable/ic_refresh" />
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:text="@string/undismiss_all" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="22dp" android:paddingBottom="8dp" android:paddingStart="4dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorPrimary"
            android:text="@string/sec_system" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_brief_card"
            android:padding="14dp">
            <LinearLayout android:id="@+id/rowMultimodal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="56dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="18dp" android:contentDescription="@null"
                    android:src="@drawable/ic_info" />
