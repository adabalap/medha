<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole brief, reached by tapping the home-screen widget.

  Laid out like the system's own brief detail view rather than like a
  settings page: a large headline, a prose line under it, then each app's
  items in a rounded card introduced by a sentence. The previous version was
  a toolbar over a bare list, which on a nearly-empty brief read as a broken
  screen rather than as "nothing to report".

  The widget shows three rows of up to twelve and rotates through the rest,
  so this is the only place the whole brief can be read at once. That makes
  the tap load-bearing, and it is why overflow is kept rather than discarded
  at write time.

  A ScrollView of generated rows, not a RecyclerView: the content is bounded
  at twelve rows across at most eight sections, so recycling buys nothing and
  an adapter would be more moving parts than the content warrants.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/briefToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_close"
            app:menu="@menu/brief_menu" />

        <ScrollView
            android:id="@+id/briefScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Deliberately large. The system's brief opens on a
                     headline, not a title bar, and the screen is read at a
                     glance rather than navigated. -->
                <!-- One capsule, two TextViews, one line.
                     The brand is wrap_content so it is never what gives way;
                     the tagline takes the remaining width and ellipsises if
                     the screen is too narrow for both. Display sizes wrapped
                     the sentence onto two lines, which is why these are a
                     step down and the capsule holds them together instead. -->
                <LinearLayout
                    android:id="@+id/briefHeadlineCapsule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_headline_capsule"
                    android:paddingStart="18dp" android:paddingEnd="18dp"
                    android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/briefHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_header_brand"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:textColor="?android:attr/textColorPrimary" />

                    <TextView
                        android:id="@+id/briefHeadlineRest"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:text="@string/widget_header_rest"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <!-- The same badge the widget leads with, in the same fixed
                     red. Everything else on this screen takes the system
                     palette; urgency never does. -->
                <TextView
                    android:id="@+id/briefOverdue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/bg_brief_overdue"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/band_overdue"
                    android:visibility="gone"
                    android:text="" />

                <TextView
                    android:id="@+id/briefSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorSecondary" />

                <!-- Sections are generated into here; see BriefActivity. -->
                <LinearLayout
                    android:id="@+id/briefContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/briefEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="28dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?android:attr/textColorSecondary"
                    android:text="@string/brief_empty"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
