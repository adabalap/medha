<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom toolbar title. The default two-line Toolbar title/subtitle clipped the
  descenders on Telugu glyphs at ?attr/actionBarSize, because that height is
  computed for Latin metrics. A wrap_content custom view sizes to the actual
  text instead.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_medha_mark"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_header_title"
            android:textColor="@color/on_indigo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/toolbarSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/state_stopped"
            android:textColor="#D8CCF4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
