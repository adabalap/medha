<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-theme overrides. Only the colors that actually need to change with
  theme are here — the brand-colored surfaces (the status card, toolbar, nav
  header, widget) all use a fixed dark indigo background by design in both
  themes and are deliberately NOT overridden here; overriding them would
  make the brand header look different depending on system theme, which
  isn't the goal. This file exists specifically to fix the four white,
  dark-text "runtime/scheduler/access/about" cards, which previously stayed
  stark white under a dark system theme because their colors were hardcoded
  hex literals with nothing here to override.
-->
<resources>
    <!-- Near-black with a faint purple cast, echoing the light theme's
         lavender surface_soft rather than a neutral grey. -->
    <color name="surface_soft">#15121C</color>
    <!-- Elevated relative to surface_soft, the way a white card reads as
         elevated against the light theme's pale lavender background. -->
    <color name="card_surface">#221D2E</color>
    <color name="text_primary">#EDE9F5</color>
    <color name="text_secondary">#C6BFD9</color>
    <!-- The light theme's stroke is a pale lavender tint of colorPrimary;
         this is the same relationship one step darker, tuned to keep the
         card outline meeting the ~3:1 non-text contrast guideline (WCAG
         2.1 SC 1.4.11) against card_surface rather than just "a bit
         darker than the card" and barely visible. This resource also backs
         the theme's colorPrimaryContainer (see themes.xml), so
         on_indigo_container is overridden alongside it below — leaving that
         at its light-theme value (dark purple text) would put low-contrast
         text on this now-dark container for any Material component that
         uses that role by default, even ones this app doesn't style
         directly. -->
    <color name="indigo_container">#746890</color>
    <color name="on_indigo_container">#EAE3FB</color>

    <!-- See the light variant for why these follow the system theme. -->
    <color name="brief_widget_bg">#D11C1630</color>
    <color name="brief_widget_title">#F4F0FF</color>
    <color name="brief_widget_body">#CFC5EA</color>
    <color name="brief_widget_meta">#9A8BC8</color>
    <color name="brief_widget_brand">#B9A9EC</color>
    <color name="brief_accent">#B9A9EC</color>
    <color name="brief_accent_wash">#24B9A9EC</color>
    <color name="brief_accent_hairline">#4DB9A9EC</color>

    <color name="brief_screen_bg">#14111C</color>
    <color name="brief_card_bg">#221D2E</color>
    <color name="brief_headline">#F4F0FF</color>

    <!-- Urgency bands, dark. Same three roles, lifted for a dark card. -->
    <color name="band_overdue">#FF7A5C</color>
    <color name="band_soon">#FFB657</color>
    <color name="band_later">#8B7DF7</color>
    <color name="band_none">#6F6793</color>
    <color name="band_overdue_tint">#26FF7A5C</color>

    <!-- User-picked accents, dark. -->
    <color name="accent_indigo">#8B7DF7</color>
    <color name="accent_teal">#3FBFA6</color>
    <color name="accent_rose">#E887B4</color>
    <color name="accent_amber">#FFB657</color>

    <!-- Band washes, dark. Lifted, because a 10% wash vanishes on a dark card. -->
    <color name="band_soon_tint">#26FFB657</color>
    <color name="band_later_tint">#268B7DF7</color>
    <color name="band_none_tint">#1FFFFFFF</color>

    <!-- Kind colours, dark. Lifted ink, stronger wash. -->
    <color name="kind_bill">#8FBCF7</color>
    <color name="kind_bill_wash">#2B8FBCF7</color>
    <color name="kind_date">#C4ADF2</color>
    <color name="kind_date_wash">#2BC4ADF2</color>
    <color name="kind_event">#63D6C4</color>
    <color name="kind_event_wash">#2B63D6C4</color>
    <color name="kind_alert">#FF9E7E</color>
    <color name="kind_alert_wash">#2BFF9E7E</color>
    <color name="kind_done">#74D492</color>
    <color name="kind_done_wash">#2B74D492</color>
    <color name="kind_note">#A7B2C4</color>
    <color name="kind_note_wash">#2BA7B2C4</color>

    <!-- Run / stop and the status dot, lifted for a dark card. The fills
         stay deep enough that white label text still reads on them; the
         dots are brightened, because a dot has no text to help it. -->
    <color name="run_green">#2E9E55</color>
    <color name="run_green_on">#06210F</color>
    <color name="stop_maroon">#B83B4A</color>
    <color name="stop_maroon_on">#2A0A0F</color>
    <color name="dot_running">#74D492</color>
    <color name="dot_working">#F0C048</color>
    <color name="dot_error">#FF8E7E</color>
    <color name="dot_idle">#A7A2C0</color>
</resources>
