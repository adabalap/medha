<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app logo. Separate from ic_launcher_foreground because @mipmap/ic_launcher
  is an ADAPTIVE icon: when an ImageView renders it directly the launcher mask
  is applied inconsistently across OEM skins, which is why the drawer mark came
  out as a lopsided squircle. This is a plain vector with its own rounded
  background, so it renders identically everywhere.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">

    <path android:pathData="M12,0h24a12,12 0 0 1 12,12v24a12,12 0 0 1 -12,12h-24a12,12 0 0 1 -12,-12v-24a12,12 0 0 1 12,-12z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="4" android:startY="2" android:endX="44" android:endY="46" android:type="linear">
                <item android:offset="0.0" android:color="#FF3B2E7E" />
                <item android:offset="0.55" android:color="#FF5B3FA8" />
                <item android:offset="1.0" android:color="#FF7C4DBC" />
            </gradient>
        </aapt:attr>
    </path>

    <group>
        <path android:pathData="M19,13 V9.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M24,13 V8.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M29,13 V9.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M19,35 V38.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M24,35 V39.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M29,35 V38.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M13,19 H9.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M13,24 H8.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M13,29 H9.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M35,19 H38.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M35,24 H39.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
        <path android:pathData="M35,29 H38.5" android:strokeColor="#FFC9BCF2" android:strokeWidth="1.9" android:strokeLineCap="round" />
    </group>

    <path android:pathData="M19,13 h10 a6,6 0 0 1 6,6 v10 a6,6 0 0 1 -6,6 h-10 a6,6 0 0 1 -6,-6 v-10 a6,6 0 0 1 6,-6 z"
        android:fillColor="#59241261" android:strokeColor="#FFEDE7FF" android:strokeWidth="1.8" />

    <!--
      Atomic orbital, centred on the chip at (24,24). Same construction as
      ic_launcher_foreground, scaled proportionally to this 48 viewport
      (48/108): rx=7.6 keeps the widest orbit clear of the chip's inner edge
      (~13.9 after its 1.8dp stroke), and holds the same rx:ry ratio as the
      launcher icon so both marks read identically.
    -->
    <group android:pivotX="24" android:pivotY="24">
        <path android:pathData="M16.4,24 a7.6,2.4 0 1,0 15.2,0 a7.6,2.4 0 1,0 -15.2,0"
            android:strokeColor="#FFFFC24B" android:strokeWidth="1.25" android:fillColor="#00000000" />
    </group>
    <group android:pivotX="24" android:pivotY="24" android:rotation="60">
        <path android:pathData="M16.4,24 a7.6,2.4 0 1,0 15.2,0 a7.6,2.4 0 1,0 -15.2,0"
            android:strokeColor="#FFFFC24B" android:strokeWidth="1.25" android:fillColor="#00000000" />
    </group>
    <group android:pivotX="24" android:pivotY="24" android:rotation="120">
        <path android:pathData="M16.4,24 a7.6,2.4 0 1,0 15.2,0 a7.6,2.4 0 1,0 -15.2,0"
            android:strokeColor="#FFFFC24B" android:strokeWidth="1.25" android:fillColor="#00000000" />
    </group>

    <path android:pathData="M24,21.5 a2.5,2.5 0 1,0 0,5 a2.5,2.5 0 1,0 0,-5"
        android:fillColor="#FF2E1C63" />
    <path android:pathData="M24,22.2 a1.8,1.8 0 1,0 0,3.6 a1.8,1.8 0 1,0 0,-3.6">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="22.2" android:startY="22.2" android:endX="25.8" android:endY="25.8"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFE8A3" />
                <item android:offset="0.55" android:color="#FFFFC24B" />
                <item android:offset="1.0" android:color="#FFF4802E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
