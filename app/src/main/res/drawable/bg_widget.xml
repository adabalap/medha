<?xml version="1.0" encoding="utf-8"?>
<!--
  Translucent rounded card, not a coloured block.

  Previously a fixed indigo gradient, which sat on the wallpaper looking
  pasted on while every system widget beside it was a soft card. 28dp
  matches the corner radius One UI uses for its own widgets, and the colour
  is semi-transparent so the wallpaper reads through it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/brief_widget_bg" />
    <corners android:radius="28dp" />
</shape>
