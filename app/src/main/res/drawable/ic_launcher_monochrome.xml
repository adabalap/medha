<!--
  Themed-icon (Android 13+) variant: a solid silhouette with no gradients,
  because the launcher retints this drawable with the user's wallpaper colours.
  Reusing the gradient foreground here produces a muddy, low-contrast result.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group>
        <path android:pathData="M44,34 V27" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M54,34 V25" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M64,34 V27" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M44,74 V81" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M54,74 V83" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M64,74 V81" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M34,44 H27" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M34,54 H25" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M34,64 H27" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M74,44 H81" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M74,54 H83" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M74,64 H81" android:strokeColor="#FFFFFFFF" android:strokeWidth="3.4" android:strokeLineCap="round" />
    </group>

    <path
        android:pathData="M44,34 h20 a10,10 0 0 1 10,10 v20 a10,10 0 0 1 -10,10 h-20 a10,10 0 0 1 -10,-10 v-20 a10,10 0 0 1 10,-10 z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.4"
        android:fillColor="#00000000" />

    <!--
      Atomic orbital, centred on the chip at (54,54). Solid strokes only: the
      launcher retints this whole drawable with wallpaper colours, so a
      gradient here just muddies it. No dark ring around the nucleus either —
      a themed icon is a single-colour silhouette, so a "ring" would be
      invisible; the nucleus simply merges with the orbit crossings into a
      solid centre, which still reads as an atom at icon size.
    -->
    <group android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M39.5,54 a14.5,4.5 0 1,0 29,0 a14.5,4.5 0 1,0 -29,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.4"
            android:fillColor="#00000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path
            android:pathData="M39.5,54 a14.5,4.5 0 1,0 29,0 a14.5,4.5 0 1,0 -29,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.4"
            android:fillColor="#00000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path
            android:pathData="M39.5,54 a14.5,4.5 0 1,0 29,0 a14.5,4.5 0 1,0 -29,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.4"
            android:fillColor="#00000000" />
    </group>

    <path
        android:pathData="M54,49 a5,5 0 1,0 0,10 a5,5 0 1,0 0,-10"
        android:fillColor="#FFFFFFFF" />
</vector>
