<?xml version="1.0" encoding="utf-8"?>
<!--
  Medha mark: an atomic orbital inside an SoC package.
  Orbital = intelligence/computation. Chip = it runs on *this device*, not a
  server.

  All content sits within x,y ∈ [25,83] of the 108 viewport, i.e. inside the
  66dp adaptive-icon keyline, so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- chip pins -->
    <group>
        <path android:pathData="M44,34 V27" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M54,34 V25" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M64,34 V27" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M44,74 V81" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M54,74 V83" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M64,74 V81" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M34,44 H27" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M34,54 H25" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M34,64 H27" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M74,44 H81" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M74,54 H83" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
        <path android:pathData="M74,64 H81" android:strokeColor="#FFC9BCF2" android:strokeWidth="3.4" android:strokeLineCap="round" />
    </group>

    <!-- chip body -->
    <path
        android:pathData="M44,34 h20 a10,10 0 0 1 10,10 v20 a10,10 0 0 1 -10,10 h-20 a10,10 0 0 1 -10,-10 v-20 a10,10 0 0 1 10,-10 z"
        android:fillColor="#59241261"
        android:strokeColor="#FFEDE7FF"
        android:strokeWidth="3" />

    <!--
      Atomic orbital: three electron paths at 0/60/120 degrees around a
      nucleus, all centred on (54,54) — the chip's exact centre.

      Radial symmetry is the point. The previous diya flame was a teardrop:
      its bounding box was roughly centred, but a teardrop carries its visual
      mass low, so it read as sinking toward the bottom of the chip. An
      orbital has no such bias — every rotation looks the same, so "centred
      on the chip" and "looks centred" are the same thing here.

      rx=14.5 keeps the widest orbit at x ∈ [39.5,68.5], clear of the chip
      body's inner edge (~35.5 after its 3dp stroke). ry is 4.5 rather than
      something fatter because three overlapping wide ellipses merge into a
      solid rosette at launcher size and stop reading as an atom at all —
      checked by rendering at a true 48px, not by eye at full size.
    -->
    <group android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M39.5,54 a14.5,4.5 0 1,0 29,0 a14.5,4.5 0 1,0 -29,0"
            android:strokeColor="#FFFFC24B"
            android:strokeWidth="2.8"
            android:fillColor="#00000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path
            android:pathData="M39.5,54 a14.5,4.5 0 1,0 29,0 a14.5,4.5 0 1,0 -29,0"
            android:strokeColor="#FFFFC24B"
            android:strokeWidth="2.8"
            android:fillColor="#00000000" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path
            android:pathData="M39.5,54 a14.5,4.5 0 1,0 29,0 a14.5,4.5 0 1,0 -29,0"
            android:strokeColor="#FFFFC24B"
            android:strokeWidth="2.8"
            android:fillColor="#00000000" />
    </group>

    <!--
      Nucleus, drawn last so the orbits pass behind it. The dark ring is
      deliberate rather than an attempt to match the chip interior: that
      colour is a semi-transparent fill over a gradient plus a radial lift,
      so any opaque "blend" value is only correct at one point. An explicit
      outline reads as depth and is right everywhere.
    -->
    <path android:pathData="M54,48.4 a5.6,5.6 0 1,0 0,11.2 a5.6,5.6 0 1,0 0,-11.2"
        android:fillColor="#FF2E1C63" />
    <path android:pathData="M54,50 a4,4 0 1,0 0,8 a4,4 0 1,0 0,-8">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50" android:startY="50"
                android:endX="58" android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFE8A3" />
                <item android:offset="0.55" android:color="#FFFFC24B" />
                <item android:offset="1.0" android:color="#FFF4802E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
