<?xml version="1.0" encoding="utf-8"?>
<!-- The tile behind a event row: something at a time.

     Tiles are keyed on KIND, not on urgency. Urgency lives in the pill and
     in the ordering, so colouring the tile by band too meant four colours
     and a screen of red whenever several things were late. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/kind_event_wash" />
    <corners android:radius="10dp" />
</shape>
