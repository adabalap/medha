<?xml version="1.0" encoding="utf-8"?>
<!-- The short vertical bar beside each brief line, the way the system's
     event rows mark theirs. Purely a reading aid: it gives the eye a left
     edge to run down when three unrelated lines share a card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/brief_accent" />
    <corners android:radius="2dp" />
</shape>
