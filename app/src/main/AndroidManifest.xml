<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      NOTE: SMS and contacts permissions are NOT declared here. They live in the
      "full" product flavour (app/src/full/AndroidManifest.xml).

      Google Play Protect blocks sideloaded APKs that declare SMS permissions,
      with "This app can request access to sensitive data." That block applies
      to the whole APK regardless of whether the user ever enables the
      connector, so declaring them unconditionally made the CORE service
      un-installable for people who only wanted inference.

      Build "core" for a clean install; build "full" only if you need the SMS
      connector, and expect to bypass Play Protect deliberately.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Declared so a device without a GPU/NPU still installs; the runtime falls
      back to CPU. Without this, some stores/installers filter the APK.
    -->
    <uses-feature android:name="android.hardware.opengles.aep" android:required="false" />

    <application
        android:name=".MedhaApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Medha"
        android:largeHeap="true"
        android:usesCleartextTraffic="true">

        <!-- Required for LiteRT-LM GPU (OpenCL) backend -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Third-party integration entry point. See MedhaAccessContract and
          docs/INTEGRATION.md.

          exported=true is required for other apps to reach it at all; the
          activity itself refuses any caller it cannot identify via
          getCallingPackage(), which is the actual security control here
          rather than the manifest.

          launchMode is deliberately left at the default "standard":
          singleTask/singleInstance make startActivityForResult return
          RESULT_CANCELED immediately, which would break every integration in
          a way that looks to the calling app like an instant user decline.

          excludeFromRecents keeps a bare consent dialog out of the recents
          list, where it would otherwise linger as a confusing Medha entry
          with no content behind it.
        -->
        <activity
            android:name=".auth.AccessRequestActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Medha.Transparent">
            <intent-filter>
                <action android:name="com.adabala.medha.action.REQUEST_ACCESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notify.MedhaWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_medha_info" />
        </receiver>

        <service
            android:name=".InferenceService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Diagnostics dumps live under filesDir/diagnostics, which is private
          to the app. Sharing one via an ACTION_SEND intent needs a content
          URI another app's share-sheet target can actually read: a raw
          file:// URI to app-private storage is rejected by modern Android
          (StrictMode FileUriExposedException) or simply unreadable by the
          receiving app. FileProvider is the standard, no-extra-dependency way
          to hand out a short-lived, scoped read grant for exactly that file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
